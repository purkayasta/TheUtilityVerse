<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
		<Nullable>disable</Nullable>
		<IsPackable>true</IsPackable>
		<PackageId>UtilityVerse</PackageId>
		<PackageVersion>1.1</PackageVersion>
		<PackageTags>utility, utils, C#, dotnet, c# utility, dotnet core</PackageTags>
		<Description>a curated list of utility methods that will help you, do your work at your
			best.</Description>
		<PackageProjectUrl>https://www.nuget.org/packages/UtilityVerse/</PackageProjectUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TheUtilityVerse</Title>
		<PackageIcon>utility-verse.png</PackageIcon>
		<PackageReadmeFile>nuget.md</PackageReadmeFile>
		<IncludeSymbols>True</IncludeSymbols>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\assets\utility-verse.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<ProjectReference Include="..\UtilityVerse.Shared\UtilityVerse.Shared.csproj" />
		<None Update="nuget.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>