<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
		<Nullable>disable</Nullable>
		<IsPackable>true</IsPackable>
		<PackageId>UtilityVerse</PackageId>
		<PackageVersion>0.7.0</PackageVersion>
		<PackageTags>utility, utils, C#, dotnet, c# utility, dotnet core</PackageTags>
		<Description>a curated list of utility methods that will help you, do your work at your
			best.</Description>
		<PackageProjectUrl>https://www.nuget.org/packages/UtilityVerse/</PackageProjectUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TheUtilityVerse</Title>
		<PackageIcon>utility-verse.png</PackageIcon>
		<PackageReadmeFile>nuget.md</PackageReadmeFile>
		<IncludeSymbols>True</IncludeSymbols>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSharedBuildOutput</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\assets\utility-verse.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<ProjectReference Include="..\UtilityVerse.Shared\UtilityVerse.Shared.csproj" PrivateAssets="all" />
		<None Include="nuget.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

    <ItemGroup>
        <None Include="examples.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- Keep Shared's assembly identity while distributing it inside the core package. -->
    <Target Name="IncludeSharedBuildOutput" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_SharedBuildOutput Include="@(ReferenceCopyLocalPaths)"
                                Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'UtilityVerse.Shared' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
            <BuildOutputInPackage Include="@(_SharedBuildOutput)" />
            <BuildOutputInPackage Include="@(_SharedBuildOutput->'%(RootDir)%(Directory)%(Filename).xml')" />
        </ItemGroup>
    </Target>
</Project>
